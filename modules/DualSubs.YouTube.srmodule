#!name = 🍿️ DualSubs: ▶️ YouTube
#!desc = YouTube 增强及双语字幕(歌词)；Shadowrocket 实验性适配
#!openUrl = http://boxjs.com/#/app/DualSubs.YouTube
#!author = VirgilClyne[https://github.com/VirgilClyne]
#!homepage = https://DualSubs.github.io/guide/youtube
#!icon = https://github.com/DualSubs/YouTube/raw/main/src/assets/icon_rounded.png
#!category = 🍿️ DualSubs
#!version = 1.6.0

# Requires Shadowrocket 2.2.79+ (WebView script engine).
# WebView is required by both YouTube and Universal bundles (URL API).
# Select YouTube subtitles > Auto-translate > the target language.
# Match original tlang URLs as well as subtype URLs for subtitle responses.

[Rule]
URL-REGEX,^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$,REJECT-TINYGIF

[Script]
# YouTube
DualSubs.YouTube.Player.request.json = type=http-request, pattern=^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, timeout=60, engine=webview, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.6.0/request.bundle.js, argument=Type=Official&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Storage=PersistentStore&LogLevel=WARN
DualSubs.YouTube.Player.response.json = type=http-response, pattern=^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, timeout=60, engine=webview, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.6.0/response.bundle.js, argument=Type=Official&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Storage=PersistentStore&LogLevel=WARN
DualSubs.YouTube.Player.request.proto = type=http-request, pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, binary-body-mode=1, timeout=60, engine=webview, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.6.0/request.bundle.js, argument=Type=Official&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Storage=PersistentStore&LogLevel=WARN
DualSubs.YouTube.Player.response.proto = type=http-response, pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, binary-body-mode=1, timeout=60, engine=webview, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.6.0/response.bundle.js, argument=Type=Official&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Storage=PersistentStore&LogLevel=WARN
DualSubs.YouTube.GetWatch.response.proto = type=http-response, pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_watch(\?.+)?$, requires-body=1, binary-body-mode=1, timeout=60, engine=webview, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.6.0/response.bundle.js, argument=Type=Official&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Storage=PersistentStore&LogLevel=WARN
DualSubs.YouTube.TimedText.request = type=http-request, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext(\?.+)?$, timeout=60, engine=webview, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.6.0/request.bundle.js, argument=Type=Official&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Storage=PersistentStore&LogLevel=WARN
DualSubs.YouTube.Composite.TimedText.response = type=http-response, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(?![^#]*subtype=Translate(?:&|$))(?:[^#]*&)?(?:tlang=[^&#]+|subtype=(?:Official|External))(?:&[^#]*)?$, requires-body=1, timeout=60, engine=webview, script-path=https://github.com/DualSubs/Universal/releases/latest/download/Composite.Subtitles.response.bundle.js, argument=Type=Official&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Storage=PersistentStore&LogLevel=WARN
DualSubs.YouTube.Translate.TimedText.response = type=http-response, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=Translate, requires-body=1, timeout=60, engine=webview, script-path=https://github.com/DualSubs/Universal/releases/latest/download/Translate.response.bundle.js, argument=Type=Official&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Storage=PersistentStore&LogLevel=WARN

# YouTube Music
DualSubs.YouTubeMusic.Browse.request.json = type=http-request, pattern=^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse(\?.+)?$, requires-body=1, timeout=60, engine=webview, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.6.0/request.bundle.js, argument=Type=Official&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Storage=PersistentStore&LogLevel=WARN
DualSubs.YouTube.Browse.request.proto = type=http-request, pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.+)?$, requires-body=1, binary-body-mode=1, timeout=60, engine=webview, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.6.0/request.bundle.js, argument=Type=Official&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Storage=PersistentStore&LogLevel=WARN
DualSubs.YouTubeMusic.Translate.Lyrics.response.json = type=http-response, pattern=^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate, requires-body=1, timeout=60, engine=webview, script-path=https://github.com/DualSubs/Universal/releases/latest/download/Translate.response.bundle.js, argument=Type=Official&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Storage=PersistentStore&LogLevel=WARN
DualSubs.YouTubeMusic.Translate.Lyrics.response.proto = type=http-response, pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate, requires-body=1, binary-body-mode=1, timeout=60, engine=webview, script-path=https://github.com/DualSubs/Universal/releases/latest/download/Translate.response.bundle.js, argument=Type=Official&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Storage=PersistentStore&LogLevel=WARN

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com, tv.youtube.com, music.youtube.com, youtubei.googleapis.com, -redirector*.googlevideo.com, *.googlevideo.com
